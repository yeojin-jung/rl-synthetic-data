base   <- read_csv("base_choices.csv", show_col_types = FALSE)
random <- read_csv("random_choices.csv", show_col_types = FALSE)
dsir   <- read_csv("dsir_choices.csv", show_col_types = FALSE)
less   <- read_csv("less_choices.csv", show_col_types = FALSE)
prism  <- read_csv("prismatic_soft_choices.csv", show_col_types = FALSE)
all_methods <- bind_rows(
base   %>% mutate(method = "base"),
random %>% mutate(method = "random"),
dsir   %>% mutate(method = "dsir"),
less   %>% mutate(method = "less"),
prism  %>% mutate(method = "prismatic_soft")
) %>%
mutate(delta_anti_minus_stereo = anti - stereo)
# (optional) keep only IDs common to all, to be extra safe
common_ids <- Reduce(intersect, list(base$id, random$id, dsir$id, less$id, prism$id))
all_methods <- all_methods %>% filter(id %in% common_ids)
# final plot: one panel per method
ggplot(all_methods, aes(x = delta_anti_minus_stereo)) +
geom_histogram(bins = 50) +
facet_wrap(~ method, scales = "free_y") +
labs(
title = "Histogram of (log P(anti) − log P(stereo)) by method",
x = "anti − stereo (log-prob difference)",
y = "count"
) +
theme_minimal(base_size = 13)
common_ids <- Reduce(intersect, list(base$id, random$id, dsir$id, less$id, prism$id))
prep <- function(df, method_name) {
df %>%
filter(id %in% common_ids) %>%
mutate(
method = method_name,
delta_anti_minus_stereo = anti - stereo
) %>%
select(id, bias_type, method, delta_anti_minus_stereo)
}
all_methods <- bind_rows(
prep(base,   "base"),
prep(random, "random"),
prep(dsir,   "dsir"),
prep(less,   "less"),
prep(prism,  "prismatic_soft")
)
# final plot: bias_type x method
ggplot(all_methods, aes(x = delta_anti_minus_stereo)) +
geom_histogram(bins = 50) +
facet_grid(bias_type ~ method, scales = "free_y") +
labs(
title = "Histogram of (log P(anti) − log P(stereo)) by bias type and method",
x = "anti − stereo (log-prob difference)",
y = "count"
) +
theme_minimal(base_size = 13)
# final plot: bias_type x method
ggplot(all_methods, aes(x = delta_anti_minus_stereo)) +
geom_histogram(bins = 50) +
facet_grid(bias_type ~ method, scales = "free_y") +
labs(
title = "Histogram of (log P(anti) − log P(stereo)) by bias type and method",
x = "anti − stereo (log-prob difference)",
y = "count"
) +
theme_minimal(base_size = 13)
# final plot: bias_type x method
ggplot(all_methods, aes(x = delta_anti_minus_stereo)) +
geom_histogram(bins = 50) +
geom_vline(xintercept = 0, color = "red", linewidth = 1) +
facet_grid(bias_type ~ method, scales = "free_y") +
labs(
title = "Histogram of (log P(anti) − log P(stereo)) by bias type and method",
x = "anti − stereo (log-prob difference)",
y = "count"
) +
theme_minimal(base_size = 13)
# final plot: bias_type x method
ggplot(all_methods, aes(x = delta_anti_minus_stereo)) +
geom_histogram(bins = 50) +
geom_vline(xintercept = 0, color = "red", linewidth = 0.5) +
facet_grid(bias_type ~ method, scales = "free_y") +
labs(
title = "Histogram of (log P(anti) − log P(stereo)) by bias type and method",
x = "anti − stereo (log-prob difference)",
y = "count"
) +
theme_minimal(base_size = 13)

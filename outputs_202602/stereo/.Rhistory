library(DescTools)
library(readr)
library(dplyr)
library(purrr)
# read data
base   <- read_csv("base_choices.csv", show_col_types = FALSE)
random <- read_csv("random_choices.csv", show_col_types = FALSE)
dsir   <- read_csv("dsir_choices.csv", show_col_types = FALSE)
less   <- read_csv("less_choices.csv", show_col_types = FALSE)
prism  <- read_csv("prismatic_soft_choices.csv", show_col_types = FALSE)
methods <- list(
random = random,
dsir = dsir,
less = less,
prismatic_soft = prism
)
# ensure chosen is a factor with consistent levels across datasets
# (adjust levels if your chosen isn't 1/2/3)
levels_chosen <- sort(unique(base$chosen))
base <- base %>% mutate(chosen = factor(chosen, levels = levels_chosen))
methods <- methods %>% map(~ .x %>% mutate(chosen = factor(chosen, levels = levels_chosen)))
run_stuart_maxwell_vs_base <- function(method_df, method_name) {
joined <- base %>%
select(id, chosen_base = chosen) %>%
inner_join(method_df %>% select(id, chosen_method = chosen), by = "id")
# Option A (recommended): pass the paired vectors
test <- StuartMaxwellTest(x = joined$chosen_base, y = joined$chosen_method)
# Option B: explicitly build the k x k table and pass it
# tab <- table(joined$chosen_base, joined$chosen_method)
# test <- StuartMaxwellTest(tab)
cat("\n===", method_name, "vs base ===\n")
print(table(joined$chosen_base, joined$chosen_method))
print(test)
invisible(test)
}
sm_results <- imap(methods, run_stuart_maxwell_vs_base)
library(ggplot2)
library(tidyr)
plot_logprob_hist_base_vs_method <- function(method_df, method_name,
cols = c("anti", "stereo", "unrelated"),
bins = 40) {
df <- base %>%
select(id, all_of(cols)) %>%
mutate(source = "base") %>%
bind_rows(
method_df %>%
select(id, all_of(cols)) %>%
mutate(source = method_name)
) %>%
semi_join(base %>% select(id), by = "id")
long <- df %>%
pivot_longer(cols = all_of(cols), names_to = "category", values_to = "logprob")
ggplot(long, aes(x = logprob, fill = source)) +
geom_histogram(position = "identity", bins = bins, alpha = 0.45) +
facet_wrap(~ category, scales = "free_x") +
labs(
title = paste0("Log-prob distributions: base vs ", method_name),
x = "log probability", y = "count", fill = ""
) +
theme_minimal(base_size = 13)
}
# Example: one plot
plot_logprob_hist_base_vs_method(random, "random")
plot_logprob_hist_base_vs_method(random, "dsir")
plot_logprob_hist_base_vs_method(random, "less")
plot_logprob_hist_base_vs_method(dsir, "dsir")
plot_logprob_hist_base_vs_method(less, "less")
plot_logprob_hist_base_vs_method(prism, "prism")
plot_logprob_hist_by_bias <- function(base_df, method_df, method_name,
cols = c("anti", "stereo", "unrelated"),
bins = 40) {
df <- base_df %>%
select(id, bias_type, all_of(cols)) %>%
mutate(source = "base") %>%
bind_rows(
method_df %>%
select(id, bias_type, all_of(cols)) %>%
mutate(source = method_name)
) %>%
semi_join(base_df %>% select(id), by = "id")
long <- df %>%
pivot_longer(cols = all_of(cols), names_to = "category", values_to = "logprob")
ggplot(long, aes(x = logprob, fill = source)) +
geom_histogram(position = "identity", bins = bins, alpha = 0.45) +
facet_grid(bias_type ~ category, scales = "free_x") +
labs(
title = paste0("Log-prob distributions by bias type: base vs ", method_name),
x = "log probability", y = "count", fill = ""
) +
theme_minimal(base_size = 13)
}
# Example:
print(plot_logprob_hist_by_bias(base, random, "random"))
print(plot_logprob_hist_by_bias(base, dsir, "dsir"))
print(plot_logprob_hist_by_bias(base, prism, "prism"))
print(plot_logprob_hist_by_bias(base, less, "less"))
View(base)
all_methods <- bind_rows(
base   %>% mutate(method = "base"),
random %>% mutate(method = "random"),
dsir   %>% mutate(method = "dsir"),
less   %>% mutate(method = "less"),
prism  %>% mutate(method = "prismatic_soft")
) %>%
mutate(delta_anti_minus_stereo = anti - stereo)
